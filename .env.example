# このファイルをコピーして .env を作成し、実際の値を入れてください(.envはgit管理対象外)
# GMAIL_SENDER_ADDRESS: 送信元のGmailアドレス
# GMAIL_APP_PASSWORD: Googleアカウントの2段階認証を有効化した上で発行する16桁のアプリパスワード
#   (通常のログインパスワードではなく、https://myaccount.google.com/apppasswords で発行する専用パスワード)
# GMAIL_RECIPIENT_ADDRESS: 通知を受け取るメールアドレス(友人のアドレス)

GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT_ADDRESS=

# GOOGLE_SHEET_ID: 対象スプレッドシートのID(URLの https://docs.google.com/spreadsheets/d/【ここ】/edit の部分)
# サービスアカウントのメールアドレス(data/credentials.jsonのclient_email)と編集権限で共有しておくこと
GOOGLE_SHEET_ID=

# DISCORD_WEBHOOK_URL: 通知したいDiscordチャンネルで発行したWebhook URL(最優先の通知チャネル)
DISCORD_WEBHOOK_URL=
